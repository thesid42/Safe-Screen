# Kernel cloud browser. If omitted, SafeScreen uses local Playwright fallback.
KERNEL_API_KEY=

# Lightcone / Tzafon Northstar. If omitted or unavailable, SafeScreen uses mock CUA actions.
TZAFON_API_KEY=
LIGHTCONE_BASE_URL=
TZAFON_MOCK_FALLBACK=true

# Optional local demo tuning.
SAFE_SCREEN_HEADLESS=false
SAFE_SCREEN_MAX_STEPS=3
