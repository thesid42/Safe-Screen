# Kernel cloud browser. If omitted, SafeScreen uses local Playwright fallback.
KERNEL_API_KEY=

# Lightcone / Tzafon Northstar. If omitted or unavailable, SafeScreen uses mock CUA actions.
TZAFON_API_KEY=
TZAFON_MODEL=tzafon.northstar-cua-fast
LIGHTCONE_BASE_URL=
TZAFON_MOCK_FALLBACK=true

# Brev-hosted local/trusted redaction model. If BREV_REDACTOR_URL is set,
# SafeScreen will call it before sending anything to the CUA model.
SAFE_SCREEN_REDACTOR_MODE=brev
SAFE_SCREEN_REDACTOR_FALLBACK=true
SAFE_SCREEN_ALLOW_REDACTOR_FALLBACK_TO_CUA=false
SAFE_SCREEN_ALLOW_LITERAL_VAULT_TYPING=false
SAFE_SCREEN_PROMPT_FOR_VALUES=true
BREV_REDACTOR_API=vllm-chat
BREV_REDACTOR_URL=
BREV_REDACTOR_TOKEN=
BREV_REDACTOR_MODEL=
BREV_REDACTOR_TIMEOUT_MS=30000
BREV_REDACTOR_MAX_TOKENS=2048
SAFE_SCREEN_REDACTION_POLICY=Redact only visible sensitive values. Do not redact labels, legends, buttons, or empty input fields.
SAFE_SCREEN_REDACT_EMPTY_FIELDS=false
SAFE_SCREEN_RULE_VALUE_FALLBACK=true

# Optional local demo tuning.
SAFE_SCREEN_HEADLESS=false
SAFE_SCREEN_MAX_STEPS=16
SAFE_SCREEN_DEMO_PROGRESS_OVERRIDE=true
SAFE_SCREEN_DEMO_PREFILL=false
SAFE_SCREEN_DEMO_SCENARIO=multistep
# Optional. Leave empty to use the scenario-specific default prompt.
SAFE_SCREEN_GOAL=
SAFE_SCREEN_RESULT_SELECTOR=#result

# Real application mode. If set, SafeScreen opens this URL instead of the built-in demo page.
SAFE_SCREEN_TARGET_URL=
SAFE_SCREEN_EMAIL_SELECTOR=#email
SAFE_SCREEN_SUBMIT_SELECTOR=#submit

# Local-only placeholder vault values.
SAFE_SCREEN_MY_NAME=Anmol Sharma
SAFE_SCREEN_MY_EMAIL=anmol@example.com
SAFE_SCREEN_MY_PHONE=925-555-1234
SAFE_SCREEN_MY_SSN=123-45-6789
SAFE_SCREEN_MY_ADDRESS=123 Main St, San Ramon, CA
SAFE_SCREEN_MY_CARD=4111 1111 1111 1111
SAFE_SCREEN_MY_USERNAME=tomsmith
SAFE_SCREEN_MY_PASSWORD=SuperSecretPassword!
